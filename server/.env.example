PORT=5001
DB_NAME=examdb
DB_USER=postgres
DB_PASSWORD=your_db_password_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DB_HOST=localhost
DB_PORT=15432
JWT_SECRET=your_jwt_secret_here
ADMIN_PIN=your_admin_pin_here

# Production (hosted Postgres): use DATABASE_URL instead of DB_*
# DATABASE_URL=postgres://user:pass@host/dbname
# CLIENT_ORIGIN=https://your-frontend.vercel.app
# GEMINI_API_KEY=
# JWT_SECRET=
# ADMIN_PIN=

# --- SMS (Eskiz.uz). Without these, codes are printed in the server log (development only) ---
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546

# --- Google sign-in (button appears only when configured) ---
# OAUTH_REDIRECT_BASE=https://your-domain.uz     # dev: http://localhost:5173 (default)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
